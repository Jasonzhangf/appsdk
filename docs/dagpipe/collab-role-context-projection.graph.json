{
  "id": "appsdk-collab-role-context-projection",
  "version": "1",
  "description": "单次context角色职责投影的SESE。输入为已解析的当前调用者范围及读取结果，输出为唯一角色投影结果。精确role模板优先于内置默认模板；多个同义角色按canonical模板去重，不同精确配置仍保留。身份、授权、目标记录和模板配置各由原owner管理，本图只生成有效职责、下一动作和目标维护入口。上游错误、取消或未提交结果作为tagged outcome透传到同一出口，不产生注册、派单、目标、订阅或消息副作用，也不使用重试回边。",
  "inputs": [
    {
      "id": "角色投影输入",
      "schema": "Object"
    }
  ],
  "nodes": [
    {
      "id": "接收身份范围与读取结果",
      "operator": "appsdk.collab_context.begin_role_projection",
      "operator_version": "1",
      "description": "接收当前身份范围、工作角色读取结果和既有错误状态。缺少身份范围或存在歧义时保留原错误，不补造worker身份。",
      "inputs": [
        "角色投影输入"
      ],
      "output": {
        "id": "角色投影上下文",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "读取角色配置与编译默认",
      "operator": "appsdk.collab_context.read_role_templates",
      "operator_version": "1",
      "description": "读取当前工作角色、精确role override和编译资产中的默认专长模板。只读当前配置，不改写角色、模板或revision。",
      "inputs": [
        "角色投影上下文"
      ],
      "output": {
        "id": "角色模板候选",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "判定身份与职责适用条件",
      "operator": "appsdk.collab_context.classify_role_applicability",
      "operator_version": "1",
      "description": "按当前typed协作身份判断管理、普通peer编排和执行专长的适用边界。工作角色标签不改变身份或授权；普通peer在明确worker专长下承担有界执行，patrol、memory和architect保持各自固定边界。",
      "inputs": [
        "角色模板候选"
      ],
      "output": {
        "id": "职责适用范围",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "按精确配置优先选择模板",
      "operator": "appsdk.collab_context.select_role_templates",
      "operator_version": "1",
      "description": "先选择实际角色对应的精确override，无override时选择明确别名对应的内置默认模板，并按canonical去重同义默认。未知专长保持原标签且不新增错误。",
      "inputs": [
        "职责适用范围"
      ],
      "output": {
        "id": "已选角色模板",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "组合职责动作与目标维护入口",
      "operator": "appsdk.collab_context.compose_role_brief",
      "operator_version": "1",
      "description": "组合有效职责、下一动作、完成动作和本人目标文档维护要求。共同目标条款只出现一次，引用正式goal owner入口而不读取目标记录；精确override正文和revision保持不变。",
      "inputs": [
        "已选角色模板"
      ],
      "output": {
        "id": "有效角色正文",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "按当前授权装饰CEO正文",
      "operator": "appsdk.collab_context.decorate_ceo_brief",
      "operator_version": "1",
      "description": "仅在现有typed CEO owner确认当前授权时装饰CEO职责，并阻止重复正文。工作角色ceo不授予权限；非CEO身份透传已有正文。",
      "inputs": [
        "有效角色正文"
      ],
      "output": {
        "id": "已装饰角色正文",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "输出角色投影结果",
      "operator": "appsdk.collab_context.emit_role_projection",
      "operator_version": "1",
      "description": "单出口返回有效正文、来源卡片或原tagged错误。成功、无默认模板、身份错误、取消和未提交状态均可落在同一结果出口。",
      "inputs": [
        "已装饰角色正文"
      ],
      "output": {
        "id": "角色投影结果",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    }
  ],
  "edges": [
    {
      "from": "接收身份范围与读取结果",
      "to": "读取角色配置与编译默认",
      "arc_id": "角色投影上下文"
    },
    {
      "from": "读取角色配置与编译默认",
      "to": "判定身份与职责适用条件",
      "arc_id": "角色模板候选"
    },
    {
      "from": "判定身份与职责适用条件",
      "to": "按精确配置优先选择模板",
      "arc_id": "职责适用范围"
    },
    {
      "from": "按精确配置优先选择模板",
      "to": "组合职责动作与目标维护入口",
      "arc_id": "已选角色模板"
    },
    {
      "from": "组合职责动作与目标维护入口",
      "to": "按当前授权装饰CEO正文",
      "arc_id": "有效角色正文"
    },
    {
      "from": "按当前授权装饰CEO正文",
      "to": "输出角色投影结果",
      "arc_id": "已装饰角色正文"
    }
  ],
  "outputs": [
    "角色投影结果"
  ]
}
