{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/plan-record.schema.json",
  "title": "AppSDK active PlanRecord",
  "type": "object",
  "required": ["schema_version", "record_type", "plan_id", "task_id", "goal_id", "module_id", "mode", "objective", "scope_paths", "steps", "rule_context", "plan_hash", "created_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "PlanRecord"},
    "plan_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "goal_id": {"type": "string", "minLength": 1},
    "module_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "scope_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "node_id", "action", "owner", "expected_evidence"],
        "additionalProperties": false,
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "node_id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "expected_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "rule_context": {
      "type": "object",
      "required": ["goal_hash", "rule_sources", "owner"],
      "additionalProperties": false,
      "properties": {
        "goal_hash": {"type": "string", "pattern": "^sha256:"},
        "rule_sources": {"type": "array"},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "plan_hash": {"type": "string", "pattern": "^sha256:"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
