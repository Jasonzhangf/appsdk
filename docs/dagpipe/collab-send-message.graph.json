{
  "id": "collab-send-message",
  "version": "1.3.0",
  "description": "消息发送 SESE 图。任何两个注册对象均可通信，角色与项目级别不限制普通发送。精确名字地址及名字继承只从本次请求的 current identity map 解析，不读业务旧占名、label 或 previous。无行、坏表、缺绑定、真实认证与持久化错误分别返回。持久提交后通知与并发消费共用当前消息事实，入队、通知接受、消费和回信分别呈现。Rex 发送只提交 durable mailbox：发送请求不读取 current Rex anchor，也不调用 adapter；提交成功后直接返回 queued，consumed=false。既有 daemon notification/timer owner 后续重读名字的单一 current anchor，合并同一目标的 pending wake 并保留每条消息，再执行 adapter。真实 adapter/persistence 错误只记录在该 owner 的通知状态中，不把发送误报为 accepted 或 consumed。已消费、已接受和结果 unknown 的消息不被 timer 重放。发送不授予任务或管理权限。",
  "inputs": [{"id": "send_request", "schema": "Object"}],
  "nodes": [
    {"id": "classify_identity", "operator": "appsdk.collab_send.classify_identity", "operator_version": "1", "inputs": ["send_request"], "output": {"id": "admitted_sender", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "classify_address_form", "operator": "appsdk.collab_send.classify_address_form", "operator_version": "1", "inputs": ["admitted_sender"], "output": {"id": "normalized_request", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "resolve_recipient_route", "operator": "appsdk.collab_send.resolve_recipient_route", "operator_version": "1", "inputs": ["normalized_request"], "output": {"id": "target_route", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "resolve_reply_route", "operator": "appsdk.collab_send.resolve_reply_route", "operator_version": "1", "description": "本机跨项目关联回复保留完整 collab-ref 的原消息 owner；旧短 ID 只在回复者所属项目解析。原消息必须属于回复者的项目/app。源认证后，在既有注册锁与源/目标有序锁内读取原消息；按随原消息提交的项目/app/名字地址核对双方恰好反转，并向唯一 identity map 核对当前 holder。已消费原消息保持历史正文、ID、参与者和真实消费回执，新 holder 可查询并回复，不重放消费。未保存原始名字地址的旧消息只保留精确 actor 兼容，不推测历史名字。不存在、owner 错误或非参与者均显式拒绝且不提交消息。", "inputs": ["authenticated_request"], "output": {"id": "reply_consistent_route", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "authenticate_source", "operator": "appsdk.collab_send.authenticate_source", "operator_version": "1", "inputs": ["target_route"], "output": {"id": "authenticated_request", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "commit_durable_message", "operator": "appsdk.collab_send.commit_durable_message", "operator_version": "1", "inputs": ["reply_consistent_route"], "output": {"id": "committed_batch", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "notify_recipient", "operator": "appsdk.collab_send.notify_recipient", "operator_version": "1", "description": "持有当前消息事实的通知 owner。Rex 分支只在既有 daemon timer/notification owner 中执行：从 durable mailbox 选择 pending batch，重新解析名字的单一 current Rex anchor，合并同目标消息，捕获 recipient、selected binding 和 wake attempt，释放状态锁后调用 native transport。返回后提交结果时必须用这些捕获事实重新核对消息当前归属：若消息已交接给新 holder 或其 wake binding 已改变，迟到的 acceptance 或 failure 仍属于原 delivery，不得写入新 holder 的 accepted/evidence/failure，也不得抑制或冒充当前 wake；未改变时才提交本次结果。native acceptance 仍不等于消费。发送请求本身不得进入此节点。", "inputs": ["committed_batch"], "output": {"id": "notification_receipt", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "emit_send_result", "operator": "appsdk.collab_send.emit_send_result", "operator_version": "1", "description": "发送结果只承认真实提交事实。本机跨项目消息只存目标项目信箱；返回兼容的项目内 msg_id 和可供原发送者执行 collab msg 的完整 message_ref。查询先在调用者自身项目认证，再从引用指定 owner 核对精确参与者并投影真实消费回执；answered 只依据反向目标信箱中双方匹配且关联原消息的已提交回复，不复制消息、不合成消费。旧短 ID 不作全局搜索。Rex durable 消息提交成功即返回 durable queued，consumed=false，repair_required=false；此结果不声称 adapter 已接受。通知接受、接收和消费由后续独立回执呈现。daemon 投递时记录的 adapter/persistence failure 留在 notification owner，不反向把已提交消息说成未入队，也不冒充 accepted 或 consumed。", "inputs": ["notification_receipt"], "output": {"id": "send_result", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"}
  ],
  "edges": [
    {"from": "classify_identity", "to": "classify_address_form", "arc_id": "admitted_sender"},
    {"from": "classify_address_form", "to": "resolve_recipient_route", "arc_id": "normalized_request"},
    {"from": "resolve_recipient_route", "to": "authenticate_source", "arc_id": "target_route"},
    {"from": "authenticate_source", "to": "resolve_reply_route", "arc_id": "authenticated_request"},
    {"from": "resolve_reply_route", "to": "commit_durable_message", "arc_id": "reply_consistent_route"},
    {"from": "commit_durable_message", "to": "notify_recipient", "arc_id": "committed_batch"},
    {"from": "notify_recipient", "to": "emit_send_result", "arc_id": "notification_receipt"}
  ],
  "outputs": ["send_result"]
}
