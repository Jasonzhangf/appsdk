{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/merge-queue-record.schema.json",
  "type": "object",
  "required": ["queue_entry_id", "issue_id", "module_id", "collaboration_id", "fix_candidate_id", "effectiveness_id", "candidate_commit", "main_base_commit", "queue_position", "merge_owner", "strategy", "status", "created_at"],
  "properties": {
    "queue_entry_id": {"type": "string"},
    "issue_id": {"type": "string"},
    "module_id": {"type": "string"},
    "collaboration_id": {"type": "string"},
    "fix_candidate_id": {"type": "string"},
    "effectiveness_id": {"type": "string"},
    "candidate_commit": {"type": "string"},
    "main_base_commit": {"type": "string"},
    "queue_position": {"type": "integer", "minimum": 1},
    "merge_owner": {"type": "string"},
    "strategy": {"const": "integration_merge_then_fast_forward"},
    "status": {"const": "admitted"},
    "created_at": {"type": "string"}
  }
}
