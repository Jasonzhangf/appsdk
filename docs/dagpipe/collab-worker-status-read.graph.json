{
  "id": "appsdk-collab-worker-status-read",
  "version": "1.1.0",
  "description": "独立的 worker 状态读取。请求选择所属项目；项目 reducer 的当前 worker 和适用 runtime binding 是身份事实，不能读取只属于 host 的 route 索引来否定项目身份。选定 adaptor 单独提供端点与活动观察；本图在观测到输出链上只加可信连续空闲状态与只读投影，不加第二入口。idle 起点只来自 AgentActivityRecord 的 trusted idle_since_ms，且只对当前 binding/session/generation 的新鲜在线 idle 成立；busy、waiting_user、offline、unknown、绑定/会话/generation 变化、daemon 重启首次观测和时钟回退都清空起点，旧记录不回填。投影中的 idle_duration_ms 仅在起点有效且 now >= 起点时计算 now - idle_since_ms。输出如实区分身份、端点和未知活动，不写身份、route、任务或凭据，不要求 board 或已分配任务存在。实现 owner 为 part_07.rs 的 worker identity/presence、projection 的共享只读函数与 part_10.rs 的 status projection。",
  "inputs": [{"id": "status_request", "schema": "Object"}],
  "nodes": [
    {"id": "resolve_project", "operator": "appsdk.collab_worker_status.resolve_project", "operator_version": "1", "inputs": ["status_request"], "output": {"id": "project_query", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "read_project_binding", "operator": "appsdk.collab_worker_status.read_project_binding", "operator_version": "1", "inputs": ["project_query"], "output": {"id": "identity_fact", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "observe_selected_endpoint", "operator": "appsdk.collab_worker_status.observe_selected_endpoint", "operator_version": "1", "description": "选定 adaptor 提供端点与宿主活动观察。活动只区分 busy/idle/waiting_user/unknown；idle 必须同时有在线 presence。观察不是 idle 时长，不能让 observed_ms 充当空闲起点。", "inputs": ["identity_fact"], "output": {"id": "status_facts", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "project_trusted_idle_projection", "operator": "appsdk.collab_worker_status.project_trusted_idle_projection", "operator_version": "1", "description": "把 AgentActivityRecord 的 trusted idle_since_ms 与当前 observed_ms 投影为 workspace 事实：project_root 取 binding 的 canonical project scope，activity、idle_since_ms、idle_duration_ms、observed_ms。无 master 或无可信起点时 activity=unknown、idle_since_ms=null、idle_duration_ms=0。只读投影，不推进任何报告水位。", "inputs": ["status_facts"], "output": {"id": "projected_status_facts", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "emit_status", "operator": "appsdk.collab_worker_status.emit_status", "operator_version": "1", "inputs": ["projected_status_facts"], "output": {"id": "status_result", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"}
  ],
  "edges": [{"from": "resolve_project", "to": "read_project_binding", "arc_id": "project_query"}, {"from": "read_project_binding", "to": "observe_selected_endpoint", "arc_id": "identity_fact"}, {"from": "observe_selected_endpoint", "to": "project_trusted_idle_projection", "arc_id": "status_facts"}, {"from": "project_trusted_idle_projection", "to": "emit_status", "arc_id": "projected_status_facts"}],
  "outputs": ["status_result"]
}
