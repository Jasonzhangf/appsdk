{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/record-graph.contract.json",
  "type": "object",
  "required": ["rules", "freshness_rules", "fix_lifecycle"],
  "properties": {
    "rules": {"type": "array", "items": {"type": "string"}},
    "freshness_rules": {"type": "array", "items": {"type": "string"}},
    "regression_rules": {"type": "array", "items": {"type": "string"}},
    "fix_lifecycle": {
      "type": "object",
      "required": ["order", "invalidation", "merge_identity"],
      "properties": {
        "order": {"const": ["clean_worktree", "baseline_reproduction", "fix_candidate_verified", "architecture_review_pass", "post_architecture_effectiveness_pass", "mainline_merge_verified"]},
        "invalidation": {"const": "candidate_commit_tree_or_scope_change_invalidates_review_and_effectiveness"},
        "merge_identity": {"const": "candidate_commit_must_be_ancestor_and_merged_tree_must_equal_reviewed_candidate_tree"}
      }
    }
  }
}
