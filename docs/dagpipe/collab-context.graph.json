{
  "id": "appsdk-collab-context",
  "version": "0.9.0",
  "description": "一次 context 请求到一次结果。CLI 解析项目与服务事实，daemon identity_gate 负责身份选择、创建、恢复、现有 host transaction 注册、默认 lease 和项目快照。身份恢复继续使用 docs/design/collab-anchor-restore-model.md 的锚点阶梯：一个设计锚点对应持久化锚点值，不以 liveness、runtime state 或 generation 作为通用恢复门；无匹配创建新身份，歧义或跨项目匹配显式失败。第一轮授权修订固定：同主体恢复键为现有 (project_scope, app_scope_id, agent_id)，由 token、持久化身份与 binding 锚点证明；旧 grant 只在该 grant 匹配旧 binding、agent、scope 和 generation 时延续，并由 part_02 在同一 typed 注册事务中提交 GlobalRuntimeBound 与重签发的 GlobalMasterGranted。pane 存在、pane 名称相同或新主体占用地址都不是主体连续性证明；新主体不继承旧 grant。删除 identity_gate 中把 unknown liveness 一律当作身份恢复阻断的授权围栏及传输专属授权例外，保留身份歧义、跨项目、endpoint 验证和真实冲突拒绝。context 的授权投影只读当前 typed grant，通信观察独立输出；授权流程仍属于 docs/dagpipe/collab-master-authority.graph.json。实现代码边当前待实现。",
  "inputs": [{"id": "context_request", "schema": "Object"}],
  "nodes": [
    {
      "id": "resolve_context_root", "operator": "appsdk.collab_context.resolve_root", "operator_version": "1",
      "inputs": ["context_request"], "output": {"id": "resolved_scope", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"
    },
    {
      "id": "ensure_baseline", "operator": "appsdk.collab_context.ensure_baseline", "operator_version": "1",
      "inputs": ["resolved_scope"], "output": {"id": "baseline_ready", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"
    },
    {
      "id": "ensure_daemon", "operator": "appsdk.collab_context.ensure_daemon", "operator_version": "1",
      "inputs": ["baseline_ready"], "output": {"id": "daemon_ready", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"
    },
    {
      "id": "identity_gate", "operator": "appsdk.collab_context.identity_gate", "operator_version": "1",
      "inputs": ["daemon_ready"], "output": {"id": "identity_result", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"
    },
    {
      "id": "env_view", "operator": "appsdk.collab_context.env_view", "operator_version": "1",
      "inputs": ["identity_result"], "output": {"id": "env_projection", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"
    },
    {
      "id": "emit_snapshot", "operator": "appsdk.collab_context.emit_snapshot", "operator_version": "1",
      "inputs": ["env_projection"], "output": {"id": "state_snapshot", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"
    }
  ],
  "edges": [
    {"from": "resolve_context_root", "to": "ensure_baseline", "arc_id": "resolved_scope"},
    {"from": "ensure_baseline", "to": "ensure_daemon", "arc_id": "baseline_ready"},
    {"from": "ensure_daemon", "to": "identity_gate", "arc_id": "daemon_ready"},
    {"from": "identity_gate", "to": "env_view", "arc_id": "identity_result"},
    {"from": "env_view", "to": "emit_snapshot", "arc_id": "env_projection"}
  ],
  "outputs": ["state_snapshot"]
}
