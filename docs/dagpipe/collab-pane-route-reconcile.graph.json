{
  "id": "appsdk-collab-pane-route-reconcile",
  "version": "0.4.0",
  "description": "SESE pane-route reconciliation graph entered only when the host route index disagrees with the project route owner. It classifies the pane claimants host-wide, resolves the owner binding, verifies that no other claim holds the pane, publishes this binding's own route at its own address only then, and returns one named outcome. One tmux pane owns exactly one route binding host-wide, so a claimant from another project is the owner of the pane and not a neighbour. The reconciler is a republisher and never evicts: while any other claim holds the pane it leaves the index untouched and records the skip, because the pane is released only by the owner's own route removal or by a fresh registration, which is a writer path and does evict. It reports the remaining lag as RECOVERY_RECONCILE_REQUIRED with the remedy. The outcome is the reconciler's own Result, not a persisted receipt type, because nothing consumes a receipt.",
  "inputs": [
    {
      "id": "route_index_disagreement",
      "schema": "Object"
    }
  ],
  "nodes": [
    {
      "id": "classify_pane_claimants",
      "operator": "appsdk.collab_pane_route.classify_claimants",
      "operator_version": "1",
      "inputs": [
        "route_index_disagreement"
      ],
      "output": {
        "id": "pane_claimant_classification",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "resolve_pane_owner",
      "operator": "appsdk.collab_pane_route.resolve_pane_owner",
      "operator_version": "1",
      "inputs": [
        "pane_claimant_classification"
      ],
      "output": {
        "id": "pane_owner_resolution",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "verify_pane_uniqueness",
      "operator": "appsdk.collab_pane_route.verify_pane_uniqueness",
      "operator_version": "1",
      "inputs": [
        "pane_owner_resolution"
      ],
      "output": {
        "id": "pane_uniqueness_postcondition",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "publish_owner_route",
      "operator": "appsdk.collab_pane_route.publish_owner_route",
      "operator_version": "1",
      "inputs": [
        "pane_uniqueness_postcondition"
      ],
      "output": {
        "id": "owner_route_publication",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "return_named_outcome",
      "operator": "appsdk.collab_pane_route.return_named_outcome",
      "operator_version": "1",
      "inputs": [
        "owner_route_publication"
      ],
      "output": {
        "id": "reconcile_outcome",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    }
  ],
  "edges": [
    {
      "from": "classify_pane_claimants",
      "to": "resolve_pane_owner",
      "arc_id": "pane_claimant_classification"
    },
    {
      "from": "resolve_pane_owner",
      "to": "verify_pane_uniqueness",
      "arc_id": "pane_owner_resolution"
    },
    {
      "from": "verify_pane_uniqueness",
      "to": "publish_owner_route",
      "arc_id": "pane_uniqueness_postcondition"
    },
    {
      "from": "publish_owner_route",
      "to": "return_named_outcome",
      "arc_id": "owner_route_publication"
    }
  ],
  "outputs": [
