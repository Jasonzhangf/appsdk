{
  "id": "collab-required-review",
  "version": "1",
  "description": "单次交付、独立审查登记、集成或关闭请求。当前任务 owner 提交独立 Codex Review 证据；以交付 revision 确认当前结果。Owner 执行真实 Git 集成和清理，保留历史证据、阻塞和人工终止。",
  "inputs": [{"id": "交付审查请求", "schema": "Object"}],
  "nodes": [
    {"id": "读取任务约束与交付记录", "operator": "collab.required_review.read", "operator_version": "1", "inputs": ["交付审查请求"], "output": {"id": "交付审查上下文", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "核对任务归属及当前审查证据", "operator": "collab.required_review.check", "operator_version": "1", "inputs": ["交付审查上下文"], "output": {"id": "审查门禁结果", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "提交待审返工或原有交付状态", "operator": "collab.required_review.commit", "operator_version": "1", "inputs": ["审查门禁结果"], "output": {"id": "持久交付结果", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "返回交付结果与下一步", "operator": "collab.required_review.emit", "operator_version": "1", "inputs": ["持久交付结果"], "output": {"id": "交付操作结果", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"}
  ],
  "edges": [
    {"from": "读取任务约束与交付记录", "to": "核对任务归属及当前审查证据", "arc_id": "交付审查上下文"},
    {"from": "核对任务归属及当前审查证据", "to": "提交待审返工或原有交付状态", "arc_id": "审查门禁结果"},
    {"from": "提交待审返工或原有交付状态", "to": "返回交付结果与下一步", "arc_id": "持久交付结果"}
  ],
  "outputs": ["交付操作结果"]
}
