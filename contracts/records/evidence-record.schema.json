{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/evidence-record.schema.json",
  "type": "object",
  "required": ["evidence_id", "issue_id", "experiment_id", "kind", "source_commit", "scope", "producer", "result", "created_at", "expires_at", "input_hashes", "scope_hash"],
  "properties": {
    "evidence_id": {"type": "string"},
    "issue_id": {"type": "string"},
    "experiment_id": {"type": "string"},
    "kind": {"enum": ["red_test", "positive_test", "negative_test", "sample_replay", "build", "artifact", "runtime", "gate"]},
    "source_commit": {"type": "string"},
    "artifact_hash": {"type": "string"},
    "scope": {"type": "object", "required": ["module_id"], "properties": {"module_id": {"type": "string"}, "feature_id": {"type": "string"}, "entrypoint": {"type": "string"}}},
    "producer": {"type": "object", "required": ["adapter", "identity"], "properties": {"adapter": {"type": "string"}, "identity": {"type": "string"}}},
    "result": {"enum": ["pass", "fail"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_rationale": {"type": "string"},
    "created_at": {"type": "string"},
    "expires_at": {"type": "string"},
    "input_hashes": {"type": "array", "items": {"type": "string"}},
    "scope_hash": {"type": "string"}
  }
}
