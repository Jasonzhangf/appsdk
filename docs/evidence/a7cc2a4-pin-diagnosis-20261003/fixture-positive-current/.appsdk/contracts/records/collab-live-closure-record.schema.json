{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/collab-live-closure-record.schema.json",
  "type": "object",
  "required": ["closure_id", "issue_id", "module_id", "fix_candidate_id", "artifact_hash", "scope_hash", "source_commit", "environment_id", "entrypoint", "collab_identity", "route_receipt", "evidence_ids", "path_receipts", "created_at"],
  "properties": {
    "closure_id": {"type": "string"},
    "issue_id": {"type": "string"},
    "module_id": {"type": "string"},
    "fix_candidate_id": {"type": "string"},
    "artifact_hash": {"type": "string"},
    "scope_hash": {"type": "string"},
    "source_commit": {"type": "string"},
    "environment_id": {"type": "string"},
    "entrypoint": {"type": "string"},
    "collab_identity": {
      "type": "object",
      "required": ["worker_id", "binding_id", "app_scope_id", "project_scope_id"],
      "properties": {
        "worker_id": {"type": "string"},
        "binding_id": {"type": "string"},
        "thread_id": {"type": "string"},
        "app_scope_id": {"type": "string"},
        "project_scope_id": {"type": "string"}
      }
    },
    "route_receipt": {
      "type": "object",
      "required": ["daemon_live", "endpoint_generation", "route_scope", "storage_root", "tmux_endpoint", "resolved_at", "source"],
      "properties": {
        "daemon_live": {"const": true},
        "endpoint_generation": {"type": "integer", "minimum": 1},
        "route_scope": {
          "type": "object",
          "required": ["project_scope", "app_scope_id"],
          "properties": {
            "project_scope": {"type": "string"},
            "app_scope_id": {"type": "string"}
          }
        },
        "storage_root": {"type": "string"},
        "tmux_endpoint": {"$ref": "#/$defs/tmux_endpoint"},
        "resolved_at": {"type": "string"},
        "source": {"const": "collab_cli"}
      }
    },
    "evidence_ids": {
      "type": "object",
      "required": ["peer_to_peer", "peer_to_master", "master_to_peer", "master_to_master", "daemon_to_peer", "daemon_to_master", "restart_replay"],
      "additionalProperties": false,
      "propertyNames": {
        "enum": ["peer_to_peer", "peer_to_master", "master_to_peer", "master_to_master", "daemon_to_peer", "daemon_to_master", "restart_replay"]
      },
      "properties": {
        "peer_to_peer": {"type": "string", "minLength": 1},
        "peer_to_master": {"type": "string", "minLength": 1},
        "master_to_peer": {"type": "string", "minLength": 1},
        "master_to_master": {"type": "string", "minLength": 1},
        "daemon_to_peer": {"type": "string", "minLength": 1},
        "daemon_to_master": {"type": "string", "minLength": 1},
        "restart_replay": {"type": "string", "minLength": 1}
      }
    },
    "path_receipts": {
      "type": "object",
      "required": ["peer_to_peer", "peer_to_master", "master_to_peer", "master_to_master", "daemon_to_peer", "daemon_to_master", "restart_replay"],
      "additionalProperties": false,
      "properties": {
        "peer_to_peer": {
          "allOf": [
            {"$ref": "#/$defs/path_receipt"},
            {"properties": {"sender": {"const": "peer"}, "receiver": {"const": "peer"}}}
          ]
        },
        "peer_to_master": {
          "allOf": [
            {"$ref": "#/$defs/path_receipt"},
            {"properties": {"sender": {"const": "peer"}, "receiver": {"const": "master"}}}
          ]
        },
        "master_to_peer": {
          "allOf": [
            {"$ref": "#/$defs/path_receipt"},
            {"properties": {"sender": {"const": "master"}, "receiver": {"const": "peer"}}}
          ]
        },
        "master_to_master": {
          "allOf": [
            {"$ref": "#/$defs/path_receipt"},
            {"properties": {"sender": {"const": "master"}, "receiver": {"const": "master"}}}
          ]
        },
        "daemon_to_peer": {
          "allOf": [
            {"$ref": "#/$defs/path_receipt"},
            {"properties": {"sender": {"const": "daemon"}, "receiver": {"const": "peer"}}}
          ]
        },
        "daemon_to_master": {
          "allOf": [
            {"$ref": "#/$defs/path_receipt"},
            {"properties": {"sender": {"const": "daemon"}, "receiver": {"const": "master"}}}
          ]
        },
        "restart_replay": {
          "allOf": [
            {"$ref": "#/$defs/path_receipt"},
            {"properties": {"sender": {"const": "daemon"}, "receiver": {"const": "peer"}}}
          ]
        }
      }
    },
    "created_at": {"type": "string"}
  },
  "$defs": {
    "tmux_endpoint": {
      "type": "object",
      "required": ["socket_path", "server_pid", "tmux_session_id", "pane_id", "pane_pid"],
      "properties": {
        "socket_path": {"type": "string", "minLength": 1},
        "server_pid": {"type": "integer", "minimum": 1},
        "tmux_session_id": {"type": "string", "pattern": "^\\$[0-9]+$"},
        "pane_id": {"type": "string", "pattern": "^%[0-9]+$"},
        "pane_pid": {"type": "integer", "minimum": 1},
        "codex_session_id": {"type": "string"},
        "codex_thread_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "path_receipt": {
      "type": "object",
      "required": ["evidence_id", "message_id", "challenge", "sender", "receiver", "source_commit", "artifact_hash", "environment_id", "entrypoint", "endpoint_generation", "observed_at"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "message_id": {"type": "string", "minLength": 1},
        "challenge": {"type": "string", "minLength": 1},
        "sender": {"enum": ["peer", "master", "daemon"]},
        "receiver": {"enum": ["peer", "master"]},
        "source_commit": {"type": "string", "minLength": 1},
        "artifact_hash": {"type": "string", "minLength": 1},
        "environment_id": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "minLength": 1},
        "endpoint_generation": {"type": "integer", "minimum": 1},
        "observed_at": {"type": "string", "minLength": 1}
      }
    }
  }
}
