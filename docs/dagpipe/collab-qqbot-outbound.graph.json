  "description": "QQBot 出站与附件 SESE 图：解析正式附件字段与原始回复 route，校验文件在授权根内可读，读取真实文件并调用平台上传接口；平台接收记录平台消息 ID 不冒充已读，明确失败或响应丢失记录 uncertain 且不盲重发。每条消息单一入口、单一结果出口。",
  "inputs": [{"id": "qq_outbound_request", "schema": "Object"}],
  "nodes": [
    {"id": "parse_attachment_fields", "operator": "appsdk.qqbot.outbound.parse_attachment_fields", "operator_version": "1", "inputs": ["qq_outbound_request"], "output": {"id": "typed_attachments", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "authorize_and_read_files", "operator": "appsdk.qqbot.outbound.authorize_and_read_files", "operator_version": "1", "inputs": ["typed_attachments"], "output": {"id": "readable_files", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
