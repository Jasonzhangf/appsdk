  "inputs": [{"id": "board_intent", "schema": "Object"}],
  "nodes": [
    {"id": "接收任务板意图", "operator": "appsdk.collab.board.admit_request", "operator_version": "1", "inputs": ["board_intent"], "output": {"id": "scoped_intent", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "校验角色所有权与版本", "operator": "appsdk.collab.board.authorize", "operator_version": "1", "inputs": ["scoped_intent"], "output": {"id": "authorized_intent", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "读取或原子提交任务真源", "operator": "appsdk.collab.board.apply", "operator_version": "1", "inputs": ["authorized_intent"], "output": {"id": "board_receipt", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "返回公共进度或明确失败", "operator": "appsdk.collab.board.project_result", "operator_version": "1", "inputs": ["board_receipt"], "output": {"id": "board_outcome", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"}
  ],
  "edges": [
    {"from": "接收任务板意图", "to": "校验角色所有权与版本", "arc_id": "scoped_intent"},
    {"from": "校验角色所有权与版本", "to": "读取或原子提交任务真源", "arc_id": "authorized_intent"},
