{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/step-execution-record.schema.json",
  "title": "AppSDK StepExecutionRecord",
  "type": "object",
  "required": ["schema_version", "record_type", "event_id", "task_id", "step_id", "result", "observations", "evidence", "plan_hash", "input_hash", "created_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "StepExecutionRecord"},
    "event_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "result": {"enum": ["pass", "fail", "blocked"]},
    "observations": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "plan_hash": {"type": "string", "pattern": "^sha256:"},
    "input_hash": {"type": "string", "pattern": "^sha256:"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
