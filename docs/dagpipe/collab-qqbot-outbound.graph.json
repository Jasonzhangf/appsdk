    {"id": "record_platform_result", "operator": "appsdk.qqbot.outbound.record_platform_result", "operator_version": "1", "inputs": ["upload_result"], "output": {"id": "platform_receipt", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "emit_send_result", "operator": "appsdk.qqbot.outbound.emit_send_result", "operator_version": "1", "inputs": ["platform_receipt"], "output": {"id": "send_result", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"}
  ],
  "edges": [
    {"from": "parse_attachment_fields", "to": "authorize_and_read_files", "arc_id": "typed_attachments"},
    {"from": "authorize_and_read_files", "to": "upload_and_send", "arc_id": "readable_files"},
