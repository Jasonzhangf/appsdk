{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/test-governance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "objects", "trusted_runners"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "selected"},
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "graph_id", "graph_version", "scope_confirmation", "semantic_graph", "scenarios"],
        "properties": {
          "object_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "graph_id": {"type": "string", "minLength": 1},
          "graph_version": {"type": "string", "minLength": 1},
          "invariants": {
            "type": "array",
            "items": {"$ref": "#/$defs/invariant"}
          },
          "semantic_graph": {"$ref": "#/$defs/semantic_graph"},
          "scope_confirmation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reference", "confirmed_by", "confirmed_at"],
            "properties": {
              "reference": {"type": "string", "minLength": 1},
              "confirmed_by": {"type": "string", "minLength": 1},
              "confirmed_at": {"type": "string", "format": "date-time"}
            }
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/scenario"}
          }
        }
      }
    },
    "trusted_runners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runner_ref", "entrypoint", "owner"],
        "properties": {
          "runner_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
          "entrypoint": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1}
        }
      }
    },
    "effect_authorizations": {
      "type": "array",
      "items": {"$ref": "#/$defs/effect_authorization"}
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "semantic_name",
        "entrypoint",
        "preconditions",
        "stimulus",
        "observable_assertions",
        "path_node_ids",
        "expected_effects",
        "cleanup",
        "runner_ref",
        "classification"
      ],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "semantic_name": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "minLength": 1},
        "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "stimulus": {"type": "string", "minLength": 1},
        "observable_assertions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "path_node_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "expected_effects": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "cleanup": {"type": "string", "minLength": 1},
        "runner_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "classification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["normal", "negative", "lifecycle", "effect"]}
        },
        "effect_authorization_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"contains": {"const": "effect"}}}, "required": ["classification"]},
          "then": {"required": ["effect_authorization_id"]}
        }
      ]
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "semantic_name", "applies_to_scenarios"],
      "properties": {
        "invariant_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "semantic_name": {"type": "string", "minLength": 1},
        "applies_to_scenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}
        }
      }
    },
    "semantic_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "exit", "nodes", "edges"],
      "properties": {
        "entry": {"type": "string", "minLength": 1},
        "exit": {"type": "string", "minLength": 1},
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1}
            }
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string", "minLength": 1},
              "to": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "effect_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "object_id",
        "scenario_id",
        "environment",
        "allowed_effects",
        "valid_from",
        "valid_until",
        "approval_ref"
      ],
      "properties": {
        "authorization_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "object_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "scenario_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "environment": {"type": "string", "minLength": 1},
        "allowed_effects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "approval_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
