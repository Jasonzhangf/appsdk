{
  "id": "appsdk-collab-merge-pending",
  "version": "0.2.0",
  "description": "One accepted delivery review enters one task lifecycle result. The reviewed delivery is classified explicitly as code or read-only. Code delivery must prove the exact delivered candidate is reachable from refs/heads/main, with or without a current master. Read-only delivery records a typed no_merge_required terminal and does not fabricate integration evidence. Both dispositions pass the normal owned-resource cleanup gate before close. Rework and force-close are separate lifecycle attempts and are not back edges in this SESE graph.",
  "inputs": [
    {
      "id": "task_review_accept",
      "schema": "Object"
    }
  ],
  "nodes": [
    {
      "id": "classify_accepted_delivery",
      "operator": "appsdk.collab_task.classify_accepted_delivery",
      "operator_version": "1",
      "inputs": ["task_review_accept"],
      "output": {"id": "classified_delivery", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "validate_delivery_disposition",
      "operator": "appsdk.collab_task.validate_delivery_disposition",
      "operator_version": "1",
      "inputs": ["classified_delivery"],
      "output": {"id": "validated_disposition", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "record_terminal_disposition",
      "operator": "appsdk.collab_task.record_terminal_disposition",
      "operator_version": "1",
      "inputs": ["validated_disposition"],
      "output": {"id": "delivery_terminal", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "validate_owned_cleanup",
      "operator": "appsdk.collab_task.validate_owned_cleanup",
      "operator_version": "1",
      "inputs": ["delivery_terminal"],
      "output": {"id": "cleanup_ready", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "close_task",
      "operator": "appsdk.collab_task.close",
      "operator_version": "1",
      "inputs": ["cleanup_ready"],
      "output": {"id": "task_closed", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    }
  ],
  "edges": [
    {"from": "classify_accepted_delivery", "to": "validate_delivery_disposition", "arc_id": "classified_delivery"},
    {"from": "validate_delivery_disposition", "to": "record_terminal_disposition", "arc_id": "validated_disposition"},
    {"from": "record_terminal_disposition", "to": "validate_owned_cleanup", "arc_id": "delivery_terminal"},
    {"from": "validate_owned_cleanup", "to": "close_task", "arc_id": "cleanup_ready"}
  ],
  "outputs": ["task_closed"]
}
