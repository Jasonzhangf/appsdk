      "iterator": "Whole"
    },
    {
      "id": "return_named_outcome",
      "operator": "appsdk.collab_pane_route.return_named_outcome",
      "operator_version": "1",
      "inputs": [
        "pane_uniqueness_postcondition"
      ],
      "output": {
        "id": "reconcile_outcome",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
