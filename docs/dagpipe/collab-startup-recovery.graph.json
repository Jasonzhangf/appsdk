{
  "id": "appsdk-collab-startup-recovery",
  "version": "1.0.1",
  "description": "单次daemon启动只从identity-map.json的active current与有界effects恢复身份。routes只定位存储和通信，reducer、archive及operation历史不能补选绑定。缺表为空且不隐式导入；坏表为核心读取错误。局部宿主/项目错误隔离到所属scope，保留名字、未读消息、未关闭任务及有效订阅。listener就绪不证明消息消费；不操作tmux生命周期。",
  "inputs": [{"id": "startup_request", "schema": "Object"}],
  "nodes": [
    {"id":"读取持久状态", "operator":"appsdk.collab_startup.read_state", "operator_version":"1", "description":"读取当前控制资源和候选存储位置，选择自有socket。身份只读当前identity-map；此阶段不创建或加载项目业务namespace。所有journal实现、读写、重放、压缩、修复及维护引用删除。", "inputs":["startup_request"], "output":{"id":"host_state", "schema":"Object"}, "input_selector":{"include":[],"exclude":[],"predicate":null}, "output_selector":{"include":[],"exclude":[],"predicate":null}, "iterator":"Whole"},
    {"id":"收敛存储归属", "operator":"appsdk.collab_startup.resolve_storage", "operator_version":"1", "description":"完成已提交reset。复用存储owner校验，确认候选实际路径、symlink containment、resident和共享route归属，再允许初始化namespace。越界和归属错误必须发生在首次业务文件写入之前。", "inputs":["host_state"], "output":{"id":"storage_scope", "schema":"Object"}, "input_selector":{"include":[],"exclude":[],"predicate":null}, "output_selector":{"include":[],"exclude":[],"predicate":null}, "iterator":"Whole"},
    {"id":"建立项目路由", "operator":"appsdk.collab_startup.load_routes", "operator_version":"1", "description":"读取路由并在需要时补写 resident 路由；校验存储 owner。", "inputs":["storage_scope"], "output":{"id":"routes", "schema":"Object"}, "input_selector":{"include":[],"exclude":[],"predicate":null}, "output_selector":{"include":[],"exclude":[],"predicate":null}, "iterator":"Whole"},
    {"id":"发现待恢复绑定", "operator":"appsdk.collab_startup.discover_bindings", "operator_version":"1", "description":"仅从统一JSON映射的active current与当前有界effects选择恢复对象；previous只供交接参考。route-only、旧typed控制行、archive和reducer绑定不能物化身份或触发补写映射。新版不存在旧表import或历史读取入口。", "inputs":["routes"], "output":{"id":"recovery_candidates", "schema":"Object"}, "input_selector":{"include":[],"exclude":[],"predicate":null}, "output_selector":{"include":[],"exclude":[],"predicate":null}, "iterator":"Whole"},
    {"id":"恢复项目状态", "operator":"appsdk.collab_startup.restore_projects", "operator_version":"1", "description":"在owner确认后按需加载当前state.json。合法未声明且无业务数据的新namespace可显式初始化；既有存储缺文件仍返回迁移错误，不静默置空。缺地址的active current保留身份、角色和当前关系，地址与订阅readiness独立报告。缺runtime/worker、精确credential、授权、真实Register提交或真实读写失败按所属scope显式报告，不合成身份或成功，不丢当前任务与消息，不阻断无关项目。", "inputs":["recovery_candidates"], "output":{"id":"project_results", "schema":"Object"}, "input_selector":{"include":[],"exclude":[],"predicate":null}, "output_selector":{"include":[],"exclude":[],"predicate":null}, "iterator":"Whole"},
    {"id":"启动服务入口", "operator":"appsdk.collab_startup.start_listener", "operator_version":"1", "description":"只安排当前已提交绑定及其有消费者的待办恢复，并建立listener。合法缺地址的身份保留；不发布虚构路由，不以完整注册校验阻断当前身份/改名效果。真正尚缺worker、授权、必要提交或写盘失败的待办保持明确未完成，不写成成功。取消或核心失败显式输出。listener就绪不等于消息投递、消费或订阅ready。", "inputs":["project_results"], "output":{"id":"listener_result", "schema":"Object"}, "input_selector":{"include":[],"exclude":[],"predicate":null}, "output_selector":{"include":[],"exclude":[],"predicate":null}, "iterator":"Whole"},
    {"id":"输出启动结果", "operator":"appsdk.collab_startup.emit_result", "operator_version":"1", "description":"区分 ready、局部 pending 或错误、核心启动错误与取消；局部 pending/错误按 scope 报告，并保留身份、未读消息、未关闭任务和有效订阅。不把 listener 就绪当作通信或消息投递完成。", "inputs":["listener_result"], "output":{"id":"startup_result", "schema":"Object"}, "input_selector":{"include":[],"exclude":[],"predicate":null}, "output_selector":{"include":[],"exclude":[],"predicate":null}, "iterator":"Whole"}
  ],
  "edges": [
    {"from":"读取持久状态", "to":"收敛存储归属", "arc_id":"host_state"},
    {"from":"收敛存储归属", "to":"建立项目路由", "arc_id":"storage_scope"},
    {"from":"建立项目路由", "to":"发现待恢复绑定", "arc_id":"routes"},
    {"from":"发现待恢复绑定", "to":"恢复项目状态", "arc_id":"recovery_candidates"},
    {"from":"恢复项目状态", "to":"启动服务入口", "arc_id":"project_results"},
    {"from":"启动服务入口", "to":"输出启动结果", "arc_id":"listener_result"}
  ],
  "outputs":["startup_result"]
}
