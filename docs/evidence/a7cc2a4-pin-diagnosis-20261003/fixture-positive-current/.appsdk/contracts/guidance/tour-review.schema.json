{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/guidance/tour-review.schema.json",
  "title": "Guide tour and ordered review proposals",
  "oneOf": [
    {
      "title": "TourProposal",
      "type": "object",
      "required": ["schema_version", "tour_id", "selected_path"],
      "properties": {
        "schema_version": {"const": 1},
        "tour_id": {"type": "string", "minLength": 1},
        "selected_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    {
      "title": "GuideReviewProposal",
      "type": "object",
      "required": ["schema_version", "review_id", "stage"],
      "properties": {
        "schema_version": {"const": 1},
        "review_id": {"type": "string", "minLength": 1},
        "stage": {"enum": ["node_review", "flow_review"]}
      },
      "oneOf": [
        {
          "properties": {
            "stage": {"const": "node_review"},
            "node_updates": {"type": "array", "minItems": 1}
          },
          "required": ["node_updates"]
        },
        {
          "properties": {
            "stage": {"const": "flow_review"},
            "flow_update": {"type": "object", "minProperties": 1}
          },
          "required": ["flow_update"]
        }
      ],
      "additionalProperties": true
    }
  ]
}
