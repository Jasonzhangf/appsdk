{
  "id": "collab-role-assignment",
  "version": "2",
  "description": "候选设计：单次分类规则维护、任务约束设置或分派请求。master 将用户自然语言转成 typed 控制请求，daemon 不解析自然语言。任务显式字段覆盖目标规则，目标覆盖项目规则；解析结果保存到任务。指定人是硬约束，角色是优先项；同角色等级内优先选择未分配 peer（0 进行中任务与 0 待处理邀请）；无匹配角色可选普通未分配或可用 peer 并返回原因，指定人不可用则等待且不静默换人。复用 invite/respond、执行容量和稳定名字归属，不新增任务状态机；等待或拒绝是本次操作结果，下次操作重新进入，无回边。",
  "inputs": [{"id": "分工请求", "schema": "Object"}],
  "nodes": [
    {"id": "读取当前任务与分工规则", "operator": "collab.assignment.read", "operator_version": "1", "inputs": ["分工请求"], "output": {"id": "分工上下文", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "合并适用规则并保存任务约束", "operator": "collab.assignment.resolve_constraints", "operator_version": "1", "inputs": ["分工上下文"], "output": {"id": "已解析任务约束", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "按指定人员或角色优先选择", "operator": "collab.assignment.select", "operator_version": "1", "inputs": ["已解析任务约束"], "output": {"id": "人员选择结果", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "准备目标长程订阅", "operator": "collab.assignment.prepare_goal_schedule", "operator_version": "1", "description": "master派发须有完整长程任务内容和显式周期，省略次数采用100。复用目标稳定名字及GoalScheduleReconcile唯一准备owner，错误和等待传递到结果出口，未选中目标不宣称armed。", "inputs": ["人员选择结果"], "output": {"id": "分派与订阅候选", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "通过现有邀请接收门禁", "operator": "collab.assignment.invite_accept", "operator_version": "1", "description": "邀请、任务表内容和目标订阅同一次持久提交。失败不部分派发。接受前提醒只要求按现有入口接单，拒绝、撤回、改派和关闭收敛同一任务订阅。", "inputs": ["分派与订阅候选"], "output": {"id": "分派提交结果", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "返回指派或等待原因", "operator": "collab.assignment.emit", "operator_version": "1", "inputs": ["分派提交结果"], "output": {"id": "分派操作结果", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"}
  ],
  "edges": [
