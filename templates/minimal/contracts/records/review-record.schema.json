{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsdk.local/contracts/records/review-record.schema.json",
  "type": "object",
  "required": ["review_id", "issue_id", "promotion_id", "reviewer", "verdict", "evidence_ids", "reviewed_commit", "reviewed_artifact_hash", "reviewed_scope_hash", "ai_confidence", "confidence_rationale", "created_at"],
  "properties": {
    "review_id": {"type": "string"},
    "issue_id": {"type": "string"},
    "promotion_id": {"type": "string"},
    "reviewer": {"type": "object", "required": ["adapter", "identity"], "properties": {"adapter": {"type": "string"}, "identity": {"type": "string"}}},
    "verdict": {"enum": ["pass", "fail", "new_version_required", "manual_auth_required"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "reviewed_commit": {"type": "string"},
    "reviewed_artifact_hash": {"type": "string"},
    "reviewed_scope_hash": {"type": "string"},
    "ai_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_rationale": {"type": "string"},
    "created_at": {"type": "string"}
  }
}
