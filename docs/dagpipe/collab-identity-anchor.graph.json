{
  "id": "appsdk-collab-identity-anchor",
  "version": "0.4.0",
  "description": "身份锚点目标设计 SESE：一次 context 或注册请求从真实宿主 session 收敛到一个持久身份、名字、binding 与 master grant，并覆盖成功、失败、待确认、取消与迁移分支。全部成功、失败、待确认和取消结果汇入同一出口“交回本次处理结果”，各自保留真实结果类型，不混成成功。名字承载工作归属，sessionID 是执行载体。TUI 首次绑定把角色注册名固定到 tmux session 并读回，Desktop 与 DSH 按各自 session 名绑定、不改 tmux；改名或持久化失败不提交身份并回滚原名；旧名字占用仅在离线或用户授权时可顶替，在线未授权进入待确认，未知不当离线；旧执行载体退役保留名字下的工作、任务与 mailbox，不误删 master；master grant 与名字交接一致迁移，失败保留原授权或按事务回滚；旧版名字状态一次性迁移后恢复不依赖旧 operation journal；重启只读当前控制槽，不把全部历史 route 当作当前绑定；同步 sessionID 或端点代际保留名字、任务、消息及适用 grant；查询已持久阶段返回真实阶段与错误且无副作用；取消与局部恢复失败只终止本次受影响路径，不清除身份、不影响其他绑定。重启恢复细节由 appsdk-collab-startup-recovery 图拥有，绑定代际与控制器由 appsdk-collab-binding-lifecycle 图拥有；本图只引用，不重复维护同一流程。重试属于下一次状态机执行，图内不画回边。本图是设计产物，不证明运行实现。",
  "inputs": [
    {"id": "context_request", "schema": "Object"}
  ],
  "nodes": [
    {
      "id": "读取当前宿主身份事实",
      "operator": "appsdk.collab_identity.collect",
      "operator_version": "1",
      "description": "从当前 Codex/DSH/Desktop 宿主采集真实 sessionID、threadID 与通信端点。TUI 的 tmux_session_name 必须来自 daemon 对当前进程的 live observation，并作为名字意图键；caller 自报的名称不进入事实。Codex Desktop 与 DSH 读取各自 session 名字。tmux session 的 $N、pane、socket、PID 和调用 cwd 只用于投递定位与观测，不能进入身份或名字决策。缺 sessionID，或 live pane 无法读取固定 session 名时显式返回 missing_facts，不用进程列表、sessionID 或历史 pane 猜身份。副作用：只读采集，不写任何身份或名字状态。",
      "inputs": ["context_request"],
      "output": {"id": "identity_facts", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "判定宿主入口与名字意图",
      "operator": "appsdk.collab_identity.classify_intent",
      "operator_version": "1",
      "description": "按真实宿主区分 TUI、Desktop、DSH，并按当前 actor、项目范围与名字占用把请求分类为首次绑定、显式继承既有名字、新注册或旧名顶替四种意图，每种输入进入对应名字决策。已有固定 session 名命中唯一 typed 占用时先进入续接；固定名无占用但同 sessionID 有唯一旧名时按旧名修复 rename；固定名与 sessionID 指向不同在线名字时显式冲突。无固定名占用且无同 session 归属时，才进入首次注册或显式授权改名。不同 cwd、不同 pane、旧 socket 或 caller 自报名不产生继承，多个候选且无唯一 typed owner 时显式冲突。副作用：只读分类，不提交。",
      "inputs": ["identity_facts"],
      "output": {"id": "identity_intent", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "拒绝缺失宿主事实",
      "operator": "appsdk.collab_identity.reject_missing_facts",
      "operator_version": "1",
      "description": "只在缺少必需宿主事实时激活：返回 missing_facts 的显式错误，说明缺哪一项，不猜名字、不绑定、不写名字或 grant。副作用：无持久写入。",
      "inputs": ["identity_facts"],
      "output": {"id": "missing_facts_outcome", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "保留名字待确认",
      "operator": "appsdk.collab_name.hold_pending",
      "operator_version": "1",
      "description": "只在候选旧名字仍被其他在线工作者占用且未获用户授权时激活：保存原操作、目标名字与占用引用，返回 pending 或 confirmation_required，停在占用确认，不静默接管、不改名。占用变化时旧待决不应用。副作用：只保留待决引用，不改名字、binding 或任务。",
      "inputs": ["identity_intent"],
      "output": {"id": "pending_outcome", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "核对旧名字持有者",
      "operator": "appsdk.collab_name.check_claimant",
      "operator_version": "1",
      "description": "按当前项目读取目标名字的 typed 占用、当前 agent sessionID 与既有 binding：离线持有者或用户明确授权可顶替，在线且未授权进入待确认，占用未知不得当作离线。同一固定名字或同一 session 的旧 claimant 进入退役分支。pane、socket、$N 和调用 cwd 不参与名字核对。副作用：只读核对，不提交。",
      "inputs": ["identity_intent"],
      "output": {"id": "claimant_decision", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "固定TUI注册名并读回",
      "operator": "appsdk.collab_identity.anchor",
      "operator_version": "1",
      "description": "仅 TUI 需要改名时激活：在名字决策已经给出 target 后，把当前 tmux session 名改为该 target 并读回确认。target 只来自显式 intent、同 sessionID、固定 tmux 名、当前 master 或普通池，不来自 pane、cwd、socket 或 $N。当前名已是 target 时幂等、不重复改名；已有固定 session 名恢复时不改名；Desktop 与 DSH 不进入本节点。改名失败或读回名不一致时按改名失败处理，终止身份提交、回滚原名、不写 binding 或 grant。副作用：只改当前 tmux session 名，可回滚。",
      "inputs": ["claimant_decision"],
      "output": {"id": "tui_anchor_result", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "同步Desktop或DSH会话名字",
      "operator": "appsdk.collab_identity.bind_native_session",
      "operator_version": "1",
      "description": "仅 Codex Desktop 与 DSH 激活：按各自 session 名绑定与续接，不执行 tmux 改名，也不把 native thread 或 gateway UUID 当作名字锚点。副作用：只解析会话名，不写身份状态。",
      "inputs": ["claimant_decision"],
      "output": {"id": "native_anchor_result", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "判定锚定结果",
      "operator": "appsdk.collab_identity.classify_anchor",
      "operator_version": "1",
      "description": "汇总 TUI 与 native 两条锚定结果，区分已锚定、改名失败与未锚定：已锚定进入提交；改名或读回失败进入改名失败分支；未锚定不继续。判定只读，不产生 `.agent-collab` 状态。",
      "inputs": ["tui_anchor_result", "native_anchor_result"],
      "output": {"id": "anchor_decision", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "记录改名失败并保留原名",
      "operator": "appsdk.collab_identity.record_anchor_failure",
      "operator_version": "1",
      "description": "只在改名失败或读回名不一致时激活：返回 explicit_failure，保留原 session 名，不写成功身份、名字或 grant。副作用：不改持久身份状态。",
      "inputs": ["anchor_decision"],
      "output": {"id": "anchor_failure_outcome", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "提交名字与当前绑定",
      "operator": "appsdk.collab_binding.commit",
      "operator_version": "1",
      "description": "锚定成功后在同一状态锁内提交固定 session 名字对应的名字占用、binding 与 endpoint generation；已提交才进入后续快照。同主体重绑递增 endpoint_generation，新 session 建立新 binding，同事实不旋转代际。提交持久化失败时回滚本次 tmux 改名并恢复旧 session 名，不留成功名字、binding 或 grant。副作用：一次原子控制提交，失败可回滚。",
      "inputs": ["anchor_decision"],
      "output": {"id": "commit_outcome", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "判定提交结果",
      "operator": "appsdk.collab_binding.classify_commit",
      "operator_version": "1",
      "description": "区分提交成功、提交失败与本次取消：成功进入退役与授权迁移；失败进入原名回滚；取消或局部恢复失败只终止本次路径。判定只读当前提交回执，不从日志或历史 route 重建结果。",
      "inputs": ["commit_outcome"],
      "output": {"id": "commit_decision", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "回滚原宿主名字",
      "operator": "appsdk.collab_identity.rollback_name",
      "operator_version": "1",
      "description": "只在提交失败时激活：把 TUI tmux session 名恢复为改名前的原名。回滚成功返回原提交失败；回滚失败返回明确未收口结果，不伪称成功，也不留下成功身份、名字或 grant。Desktop 与 DSH 无 tmux 名可回滚时按所属会话名显式报告。副作用：只恢复宿主 session 名。",
      "inputs": ["commit_decision"],
      "output": {"id": "rollback_outcome", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "取消与局部恢复失败",
      "operator": "appsdk.collab_identity.cancel_partial",
      "operator_version": "1",
      "description": "只在客户端取消或局部恢复失败时激活：只终止本次受影响路径，不删除名字、binding、grant、任务或 mailbox，也不影响其他绑定。返回真实取消或局部失败结果，不合成成功。副作用：不写身份状态。",
      "inputs": ["commit_decision"],
      "output": {"id": "partial_failure_outcome", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "退役旧执行载体",
      "operator": "appsdk.collab_identity.retire_claimant",
      "operator_version": "1",
      "description": "提交成功后退役同一固定名字或同一 session 的旧 claimant：原子提交 WorkerClosed，保留名字承载的工作、未关闭任务与 mailbox，不误删当前 master grant，也不停止旧进程。名字仍归当前工作者，旧 sessionID 不再阻塞续接；pane 只保留投递用途。副作用：退役旧绑定，保留工作归属。",
      "inputs": ["commit_decision"],
      "output": {"id": "retired_outcome", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "迁移 master 授权",
      "operator": "appsdk.collab_master.handoff",
      "operator_version": "1",
      "description": "退役后按固定名字交接 master grant：同 principal 同名字且 generation 递增时重发原 grant；Jenny 及其它 master 恢复需 typed user authorization。迁移与名字交接保持一致，grant 跟随名字迁移；失败保留原授权或按事务回滚，不因 holder 退役被动清除 master。副作用：写 typed master grant 迁移，失败可回滚。",
      "inputs": ["retired_outcome"],
      "output": {"id": "grant_outcome", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "迁移旧版名字状态",
      "operator": "appsdk.collab_name.migrate_legacy",
      "operator_version": "1",
      "description": "仅在读到旧版名字记录时激活：旧 pane_anchor 只作为一次性迁移输入，按名字持有者重建 typed 名字控制并把工作归属迁到当前名字持有者；迁移后恢复只按 sessionID 与固定 tmux 名，不读旧 pane 记录，不重放旧 operation journal，也不重放旧执行者。无需迁移时无写入。副作用：一次迁移提交，保留历史快照不可变。",
      "inputs": ["grant_outcome"],
      "output": {"id": "legacy_migration_outcome", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "重启读取当前控制槽",
      "operator": "appsdk.collab_identity.read_control_slot",
      "operator_version": "1",
      "description": "重启后只从当前控制槽与当前 route 读取当前绑定，不把全部历史 route 当作当前绑定，也不从业务 journal 枚举重建绑定；单个局部项目错误按 scope 显式隔离。恢复细节由 appsdk-collab-startup-recovery 图拥有。副作用：只读当前控制，保持身份、未读消息、未关闭任务与有效订阅。",
      "inputs": ["legacy_migration_outcome"],
      "output": {"id": "restart_control", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "同步 sessionID 与端点代际",
      "operator": "appsdk.collab_identity.sync_carrier",
      "operator_version": "1",
      "description": "名字仍归当前工作者而 sessionID 或端点变化时，更新该名字的 sessionID 与 endpoint generation，并同步名字下全部未关闭任务的 sessionID；保留名字、任务、消息、证据及适用 grant，旧代际不能覆盖新代际。副作用：一次控制提交，保留工作归属。",
      "inputs": ["restart_control"],
      "output": {"id": "generation_outcome", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "查询已持久阶段",
      "operator": "appsdk.collab_identity.query_phase",
      "operator_version": "1",
      "description": "对已持久操作按 operation key 返回真实 phase、outcome、committed_phases 与原始错误；不补 Register、binding、route、grant 或业务回执，不虚构后续阶段。副作用：只读查询，host journal、host routes 与 project journal 字节不变。",
      "inputs": ["generation_outcome"],
      "output": {"id": "query_outcome", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "交回本次处理结果",
      "operator": "appsdk.collab_identity.emit_outcome",
      "operator_version": "1",
      "description": "汇总成功、失败、待确认与取消的各类终点并返回本次真实结果：成功返回名字、角色、固定 session 名、binding、master grant 与可达性；缺失宿主事实返回 missing_facts；占用未授权返回 pending/confirmation_required；改名失败返回 explicit_failure；提交失败返回原失败或回滚未收口；取消返回真实取消结果；查询返回真实阶段与错误。不同终点保留各自结果类型，不把 pending、失败或取消表示为 registered/committed。",
      "inputs": [
        "missing_facts_outcome",
        "pending_outcome",
        "anchor_failure_outcome",
        "rollback_outcome",
        "partial_failure_outcome",
        "query_outcome"
      ],
      "output": {"id": "identity_anchor_outcome", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    }
  ],
  "edges": [
    {"from": "读取当前宿主身份事实", "to": "判定宿主入口与名字意图", "arc_id": "identity_facts"},
    {"from": "读取当前宿主身份事实", "to": "拒绝缺失宿主事实", "arc_id": "identity_facts"},
    {"from": "判定宿主入口与名字意图", "to": "核对旧名字持有者", "arc_id": "identity_intent"},
    {"from": "判定宿主入口与名字意图", "to": "保留名字待确认", "arc_id": "identity_intent"},
    {"from": "核对旧名字持有者", "to": "固定TUI注册名并读回", "arc_id": "claimant_decision"},
    {"from": "核对旧名字持有者", "to": "同步Desktop或DSH会话名字", "arc_id": "claimant_decision"},
    {"from": "固定TUI注册名并读回", "to": "判定锚定结果", "arc_id": "tui_anchor_result"},
    {"from": "同步Desktop或DSH会话名字", "to": "判定锚定结果", "arc_id": "native_anchor_result"},
    {"from": "判定锚定结果", "to": "记录改名失败并保留原名", "arc_id": "anchor_decision"},
    {"from": "判定锚定结果", "to": "提交名字与当前绑定", "arc_id": "anchor_decision"},
    {"from": "提交名字与当前绑定", "to": "判定提交结果", "arc_id": "commit_outcome"},
    {"from": "判定提交结果", "to": "回滚原宿主名字", "arc_id": "commit_decision"},
    {"from": "判定提交结果", "to": "取消与局部恢复失败", "arc_id": "commit_decision"},
    {"from": "判定提交结果", "to": "退役旧执行载体", "arc_id": "commit_decision"},
    {"from": "退役旧执行载体", "to": "迁移 master 授权", "arc_id": "retired_outcome"},
    {"from": "迁移 master 授权", "to": "迁移旧版名字状态", "arc_id": "grant_outcome"},
    {"from": "迁移旧版名字状态", "to": "重启读取当前控制槽", "arc_id": "legacy_migration_outcome"},
    {"from": "重启读取当前控制槽", "to": "同步 sessionID 与端点代际", "arc_id": "restart_control"},
    {"from": "同步 sessionID 与端点代际", "to": "查询已持久阶段", "arc_id": "generation_outcome"},
    {"from": "查询已持久阶段", "to": "交回本次处理结果", "arc_id": "query_outcome"},
    {"from": "拒绝缺失宿主事实", "to": "交回本次处理结果", "arc_id": "missing_facts_outcome"},
    {"from": "保留名字待确认", "to": "交回本次处理结果", "arc_id": "pending_outcome"},
    {"from": "记录改名失败并保留原名", "to": "交回本次处理结果", "arc_id": "anchor_failure_outcome"},
    {"from": "回滚原宿主名字", "to": "交回本次处理结果", "arc_id": "rollback_outcome"},
    {"from": "取消与局部恢复失败", "to": "交回本次处理结果", "arc_id": "partial_failure_outcome"}
  ],
  "outputs": ["identity_anchor_outcome"]
}
