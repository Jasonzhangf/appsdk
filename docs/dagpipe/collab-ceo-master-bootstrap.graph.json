    {"id":"start_real_codex","operator":"collab.ceo.bootstrap.launch","operator_version":"1","inputs":["launch_intent"],"output":{"id":"launch_outcome","schema":"Object"},"input_selector":{"include":[],"exclude":[],"predicate":null},"output_selector":{"include":[],"exclude":[],"predicate":null},"iterator":"Whole"},
