{
  "id": "collab-send-message",
  "version": "1.1.0",
  "description": "消息发送 SESE 图。任何两个注册对象均可通信，角色与项目级别不限制普通发送。精确名字地址及名字继承只从本次请求的 current identity map 解析，不读业务旧占名、label 或 previous。无行、坏表、缺绑定、真实认证与持久化错误分别返回。持久提交后通知与并发消费共用当前消息事实，入队、通知接受、消费和回信分别呈现。发送不授予任务或管理权限。",
  "inputs": [{"id": "send_request", "schema": "Object"}],
  "nodes": [
    {"id": "classify_identity", "operator": "appsdk.collab_send.classify_identity", "operator_version": "1", "inputs": ["send_request"], "output": {"id": "admitted_sender", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "classify_address_form", "operator": "appsdk.collab_send.classify_address_form", "operator_version": "1", "inputs": ["admitted_sender"], "output": {"id": "normalized_request", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "resolve_recipient_route", "operator": "appsdk.collab_send.resolve_recipient_route", "operator_version": "1", "inputs": ["normalized_request"], "output": {"id": "target_route", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "resolve_reply_route", "operator": "appsdk.collab_send.resolve_reply_route", "operator_version": "1", "inputs": ["target_route"], "output": {"id": "reply_consistent_route", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "authenticate_source", "operator": "appsdk.collab_send.authenticate_source", "operator_version": "1", "inputs": ["reply_consistent_route"], "output": {"id": "authenticated_request", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "commit_durable_message", "operator": "appsdk.collab_send.commit_durable_message", "operator_version": "1", "inputs": ["authenticated_request"], "output": {"id": "committed_batch", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "notify_recipient", "operator": "appsdk.collab_send.notify_recipient", "operator_version": "1", "description": "持有当前消息事实的通知 owner。选择批次时捕获 recipient、selected binding 和 wake attempt，释放状态锁后调用 native transport。返回后提交结果时必须用这些捕获事实重新核对消息当前归属：若消息已交接给新 holder 或其 wake binding 已改变，迟到的 acceptance 或 failure 仍属于原 delivery，不得写入新 holder 的 accepted/evidence/failure，也不得抑制或冒充当前 wake；未改变时才提交本次结果。native acceptance 仍不等于消费。", "inputs": ["committed_batch"], "output": {"id": "notification_receipt", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
    {"id": "emit_send_result", "operator": "appsdk.collab_send.emit_send_result", "operator_version": "1", "inputs": ["notification_receipt"], "output": {"id": "send_result", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"}
  ],
  "edges": [
    {"from": "classify_identity", "to": "classify_address_form", "arc_id": "admitted_sender"},
    {"from": "classify_address_form", "to": "resolve_recipient_route", "arc_id": "normalized_request"},
    {"from": "resolve_recipient_route", "to": "resolve_reply_route", "arc_id": "target_route"},
    {"from": "resolve_reply_route", "to": "authenticate_source", "arc_id": "reply_consistent_route"},
    {"from": "authenticate_source", "to": "commit_durable_message", "arc_id": "authenticated_request"},
    {"from": "commit_durable_message", "to": "notify_recipient", "arc_id": "committed_batch"},
    {"from": "notify_recipient", "to": "emit_send_result", "arc_id": "notification_receipt"}
  ],
  "outputs": ["send_result"]
}
