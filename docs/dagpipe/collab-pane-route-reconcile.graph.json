        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "verify_scope_pane_uniqueness",
      "operator": "appsdk.collab_pane_route.verify_scope_uniqueness",
      "operator_version": "1",
      "inputs": [
        "owner_route_publication"
      ],
      "output": {
        "id": "scope_pane_uniqueness_postcondition",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "return_named_outcome",
      "operator": "appsdk.collab_pane_route.return_named_outcome",
      "operator_version": "1",
      "inputs": [
        "scope_pane_uniqueness_postcondition"
      ],
      "output": {
        "id": "reconcile_outcome",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
