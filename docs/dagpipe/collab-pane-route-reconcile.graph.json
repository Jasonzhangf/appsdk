{
  "id": "appsdk-collab-pane-route-reconcile",
  "version": "0.3.0",
  "description": "SESE pane-route reconciliation graph entered only when the host route index disagrees with the project route owner. It classifies the scope-local pane claimants, resolves the scope-local owner binding, publishes that owner route when the host index lagged, verifies the scope-local uniqueness postcondition, and returns one named outcome: either the reconciler converges with no live conflict, or it names the remaining scope-local conflict and its remedy. A claimant from another project scope is never a conflict. Two claimants inside one scope stay ambiguous, and a claimant an operator retired is not a claimant at all: it is skipped and the address is never republished. The outcome is the reconciler's own Result, not a persisted receipt type, because nothing consumes a receipt.",
  "inputs": [
    {
      "id": "route_index_disagreement",
      "schema": "Object"
    }
  ],
  "nodes": [
    {
      "id": "classify_pane_claimants",
      "operator": "appsdk.collab_pane_route.classify_claimants",
      "operator_version": "1",
      "inputs": [
        "route_index_disagreement"
      ],
      "output": {
        "id": "pane_claimant_classification",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "resolve_scope_pane_owner",
      "operator": "appsdk.collab_pane_route.resolve_scope_pane_owner",
      "operator_version": "1",
      "inputs": [
        "pane_claimant_classification"
      ],
      "output": {
        "id": "scope_pane_owner_resolution",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "publish_owner_route",
      "operator": "appsdk.collab_pane_route.publish_owner_route",
      "operator_version": "1",
      "inputs": [
        "scope_pane_owner_resolution"
      ],
      "output": {
