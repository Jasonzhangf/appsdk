    {
      "id": "emit_outcome",
      "operator": "appsdk.collab_adjudication.emit_outcome",
      "operator_version": "1",
      "inputs": ["adjudicated_binding"],
      "output": {"id": "adjudication_result", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    }
  ],
  "edges": [
    {"from": "parse_declaration", "to": "load_target", "arc_id": "adjudication_request"},
    {"from": "load_target", "to": "collect_inherited", "arc_id": "target_principal"},
    {"from": "collect_inherited", "to": "write_receipt", "arc_id": "inherited_state"},
