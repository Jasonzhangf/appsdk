{
  "id": "appsdk-collab-control-plane-reset",
  "version": "0.3.0",
  "description": "当前项目 master 在线 reset 的 SESE 图。认证当前项目 master 后，在现有 daemon 内串行化项目变更，先持久记录 scoped reset intent，再删除本项目历史消息、任务、route、身份、订阅、操作、资产与负载。共享 journal 由其 writer owner 持锁压缩，物理删除目标历史并保留其他项目。未完成 intent 在启动路由恢复前继续删除。全局 daemon、socket、PID、lock 和其他项目不变；不经过离线、归档、历史身份批准或维护入口。真实写入或删除失败返回 RESET_INCOMPLETE，不能宣称成功。用户主机维护不属于本图。",
  "inputs": [{"id": "reset_request", "schema": "Object"}],
  "nodes": [
    {
      "id": "authorize_reset",
      "operator": "appsdk.collab_control_plane.authorize_reset",
      "operator_version": "1",
      "inputs": ["reset_request"],
      "output": {"id": "authorized_reset_request", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "online_project_reset",
      "description": "当前 master 认证后沿现有全局锁顺序 identity → materialization → route publication → project wire 串行化删除；resident route 恢复同样先 materialization 再 publication，避免跨项目锁反转。",
      "operator": "appsdk.collab_control_plane.online_project_reset",
      "operator_version": "1",
      "inputs": ["authorized_reset_request"],
      "output": {"id": "online_project_result", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    },
    {
      "id": "record_reset_receipt",
      "operator": "appsdk.collab_control_plane.record_reset_receipt",
      "operator_version": "1",
      "inputs": ["online_project_result"],
      "output": {"id": "reset_receipt", "schema": "Object"},
      "input_selector": {"include": [], "exclude": [], "predicate": null},
      "output_selector": {"include": [], "exclude": [], "predicate": null},
      "iterator": "Whole"
    }
  ],
  "edges": [
    {"from": "authorize_reset", "to": "online_project_reset", "arc_id": "authorized_reset_request"},
    {"from": "online_project_reset", "to": "record_reset_receipt", "arc_id": "online_project_result"}
  ],
  "outputs": ["reset_receipt"]
}
