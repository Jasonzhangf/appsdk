    {"id": "project_readable_text", "operator": "appsdk.qqbot.inbound.project_readable_text", "operator_version": "1", "inputs": ["saved_attachments"], "output": {"id": "readable_projection", "schema": "Object"}, "input_selector": {"include": [], "exclude": [], "predicate": null}, "output_selector": {"include": [], "exclude": [], "predicate": null}, "iterator": "Whole"},
