  "findings": [
    {
      "severity": "P1",
      "file": "collab/src/adapters/rex.rs",
      "line": 1231,
      "rule": "A program-status owner is usable only when its pid and name are complete and can be reliably compared with the current foreground owner.",
      "evidence": "The decoder accepts any numeric pid and any string name, including pid 0 or an empty/whitespace-only name. The monitor then compares these values directly at lines 231-233. A malformed owner with the same incomplete values as a malformed foreground process can therefore enter the current-record set and project working or waiting_user instead of remaining unknown. The plan requires incomplete owner evidence to be excluded, and the ontology requires pid/name owner identity to be complete before projection.",
      "remediation": "Treat non-positive pid and blank owner names as incomplete during decoding, and treat blank foreground identity as unavailable. Preserve the record for diagnostics if required, but exclude it from activity aggregation or mark the observation incomplete so the public projection remains unknown."
    },
    {
