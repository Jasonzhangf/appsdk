        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "iterator": "Whole"
    },
    {
      "id": "verify_pane_uniqueness",
      "operator": "appsdk.collab_pane_route.verify_pane_uniqueness",
      "operator_version": "1",
      "inputs": [
        "owner_route_publication"
      ],
      "output": {
        "id": "pane_uniqueness_postcondition",
        "schema": "Object"
      },
      "input_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
      },
      "output_selector": {
        "include": [],
        "exclude": [],
        "predicate": null
