{
  "schema_version": 1,
  "scenarios": [
    {
      "scenario_id": "multi_worker_collaboration",
      "status": "active",
      "owner": "appsdk::collaboration",
      "requires": ["multi_worktree_merge_queue"],
      "invariants": [
        "one_worker_one_clean_worktree",
        "one_worker_one_semantic_claim",
        "workers_never_write_main"
      ],
      "required_records": ["CollaborationRecord", "WorktreeRecord"]
    },
    {
      "scenario_id": "multi_worktree_merge_queue",
      "status": "active",
      "owner": "appsdk::merge_queue",
      "requires": ["multi_worker_collaboration"],
      "invariants": [
        "single_merge_owner",
        "serial_queue",
        "tested_integration_commit_enters_main",
        "remote_main_receipt_before_cleanup"
      ],
      "required_records": [
        "MergeQueueRecord",
        "IntegrationRecord",
        "MainlineReceiptRecord",
        "MergeRecord"
      ]
    }
  ],
  "composition_rules": [
    {
      "rule_id": "parallel-development-pair",
      "members": ["multi_worker_collaboration", "multi_worktree_merge_queue"],
      "activation": "all_or_none"
    }
  ]
}
